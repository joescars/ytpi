[Unit]
Description=YouTube Video Downloader Service
After=network.target

[Service]
Type=simple
User=joe
WorkingDirectory=/home/joe/services/ytpi
Environment=PATH=/home/joe/services/ytpi/venv/bin
ExecStart=/home/joe/services/ytpi/venv/bin/python app.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
